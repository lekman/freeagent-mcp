{
  "name": "@lekman/freeagent",
  "version": "1.2.1",
  "description": "FreeAgent API client: OAuth token lifecycle and typed reads over invoices, bills, expenses and timeslips.",
  "license": "MIT",
  "author": "Tobias Lekman",
  "homepage": "https://github.com/lekman/freeagent-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lekman/freeagent-mcp.git"
  },
  "keywords": [
    "freeagent",
    "accounting",
    "oauth",
    "invoices",
    "bookkeeping"
  ],
  "type": "module",
  "packageManager": "bun@1.3.14",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "freeagent": "./dist/bin/freeagent.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "typecheck": "bun --bun tsc --noEmit",
    "lint": "prettier --check . && eslint .",
    "fmt": "prettier --write . && eslint . --fix",
    "hooks": "bun run scripts/hooks.ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "verify": "bun run typecheck && bun run lint && bun run test:coverage",
    "check": "bun run lint && bun run typecheck && bun run test:coverage && bun run build && bun run hooks"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/bun": "1.3.14",
    "@types/node": "26.2.0",
    "eslint": "10.8.1",
    "eslint-plugin-jsdoc": "64.2.0",
    "eslint-plugin-perfectionist": "5.10.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "zod": "4.6.5"
  }
}
